{
  "$defs": {
    "ActorType": {
      "enum": [
        "protest_organiser",
        "student_candidate",
        "parent",
        "government_representative",
        "education_exam_authority",
        "police",
        "ruling_party",
        "opposition_party",
        "court_public_institution",
        "anchor_correspondent",
        "guest_expert",
        "other_relevant_actor"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "CertaintyTreatment": {
      "enum": [
        "explicitly_qualified",
        "implicitly_qualified",
        "asserted_as_fact",
        "contested",
        "unclear"
      ],
      "title": "CertaintyTreatment",
      "type": "string"
    },
    "ClaimType": {
      "enum": [
        "observed_fact",
        "verified_fact",
        "reported_allegation",
        "speaker_allegation",
        "opinion",
        "question",
        "speculation",
        "prediction",
        "quotation",
        "unclear"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "EvidenceTier": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "title": "EvidenceTier",
      "type": "string"
    },
    "FrameLabel": {
      "enum": [
        "legitimising",
        "delegitimising",
        "criminalising",
        "victimising",
        "heroising",
        "law_and_order",
        "civil_rights",
        "institutional_accountability",
        "institutional_trust",
        "public_disruption",
        "electoral_political",
        "procedural_legal",
        "human_interest",
        "evidence_verification",
        "other"
      ],
      "title": "FrameLabel",
      "type": "string"
    },
    "SpeakerRole": {
      "enum": [
        "anchor",
        "correspondent",
        "guest",
        "expert",
        "interviewee",
        "voiceover",
        "quoted_source",
        "institutional_statement",
        "unknown",
        "not_applicable"
      ],
      "title": "SpeakerRole",
      "type": "string"
    },
    "StanceDirection": {
      "enum": [
        "favourable",
        "critical",
        "neutral_descriptive",
        "mixed",
        "unclear",
        "insufficient_evidence"
      ],
      "title": "StanceDirection",
      "type": "string"
    },
    "TopicLabel": {
      "enum": [
        "protest_demands",
        "student_candidate_experience",
        "parent_response",
        "examination_administration",
        "government_response",
        "policing_public_order",
        "party_politics",
        "courts_legal_process",
        "public_disruption",
        "evidence_verification",
        "other_relevant"
      ],
      "title": "TopicLabel",
      "type": "string"
    }
  },
  "$id": "https://project-parallax.example/schemas/reliability-annotation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotation_version": {
      "pattern": "^1\\.0\\.0$",
      "title": "Annotation Version",
      "type": "string"
    },
    "certainty": {
      "$ref": "#/$defs/CertaintyTreatment"
    },
    "claim_type": {
      "$ref": "#/$defs/ClaimType"
    },
    "evidence_tier": {
      "$ref": "#/$defs/EvidenceTier"
    },
    "frame_labels": {
      "items": {
        "$ref": "#/$defs/FrameLabel"
      },
      "maxItems": 20,
      "title": "Frame Labels",
      "type": "array"
    },
    "record_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$",
      "title": "Record Id",
      "type": "string"
    },
    "reviewer_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$",
      "title": "Reviewer Id",
      "type": "string"
    },
    "round_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Round Id",
      "type": "string"
    },
    "speaker_role": {
      "$ref": "#/$defs/SpeakerRole"
    },
    "stance": {
      "$ref": "#/$defs/StanceDirection"
    },
    "target_actor_name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Target Actor Name",
      "type": "string"
    },
    "target_actor_type": {
      "$ref": "#/$defs/ActorType"
    },
    "topic_labels": {
      "items": {
        "$ref": "#/$defs/TopicLabel"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Topic Labels",
      "type": "array"
    }
  },
  "required": [
    "annotation_version",
    "record_id",
    "reviewer_id",
    "round_id",
    "target_actor_name",
    "target_actor_type",
    "speaker_role",
    "stance",
    "claim_type",
    "certainty",
    "evidence_tier",
    "topic_labels"
  ],
  "title": "ReliabilityAnnotation",
  "type": "object"
}
